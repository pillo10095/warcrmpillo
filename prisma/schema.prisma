generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(255)
  avatarUrl    String?  @map("avatar_url") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  sessions      Session[]
  accountMember AccountMember?
  profile       Profile?

  @@map("users")
}

model Session {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @map("user_id") @db.VarChar(36)
  tokenHash  String   @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime @map("expires_at") @db.DateTime(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id              String   @id @default(uuid()) @db.VarChar(36)
  name            String   @db.VarChar(255)
  ownerUserId     String   @unique @map("owner_user_id") @db.VarChar(36)
  defaultCurrency String   @default("USD") @map("default_currency") @db.VarChar(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  members           AccountMember[]
  invitations       Invitation[]
  apiKeys           ApiKey[]
  webhookEndpoints  WebhookEndpoint[]
  contacts          Contact[]
  tags              Tag[]
  conversations     Conversation[]
  whatsappConfigs   WhatsAppConfig[]
  messageTemplates  MessageTemplate[]
  broadcasts        Broadcast[]
  notifications     Notification[]
  memberPresences   MemberPresence[]
  aiConfigs         AiConfig[]
  aiKnowledgeDocs   AiKnowledgeDocument[]
  aiKnowledgeChunks AiKnowledgeChunk[]
  aiUsageLogs       AiUsageLog[]

  @@map("accounts")
}

model AccountMember {
  userId    String      @id @map("user_id") @db.VarChar(36)
  accountId String      @map("account_id") @db.VarChar(36)
  role      AccountRole
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_members")
}

enum AccountRole {
  owner
  admin
  agent
  viewer
}

model Invitation {
  id               String      @id @default(uuid()) @db.VarChar(36)
  accountId        String      @map("account_id") @db.VarChar(36)
  tokenHash        String      @unique @map("token_hash") @db.VarChar(64)
  role             AccountRole
  createdByUserId  String?     @map("created_by_user_id") @db.VarChar(36)
  label            String?     @db.VarChar(255)
  createdAt        DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt        DateTime    @map("expires_at") @db.DateTime(3)
  acceptedAt       DateTime?   @map("accepted_at") @db.DateTime(3)
  acceptedByUserId String?     @map("accepted_by_user_id") @db.VarChar(36)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("account_invitations")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.VarChar(36)
  accountId  String    @map("account_id") @db.VarChar(36)
  createdBy  String?   @map("created_by") @db.VarChar(36)
  name       String    @db.VarChar(255)
  keyPrefix  String    @map("key_prefix") @db.VarChar(64)
  keyHash    String    @unique @map("key_hash") @db.VarChar(64)
  scopes     String    @default("[]") @db.VarChar(2048)
  lastUsedAt DateTime? @map("last_used_at") @db.DateTime(3)
  expiresAt  DateTime? @map("expires_at") @db.DateTime(3)
  revokedAt  DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("api_keys")
}

model FileRecord {
  id           String   @id @default(uuid()) @db.VarChar(36)
  accountId    String   @map("account_id") @db.VarChar(36)
  originalName String   @map("original_name") @db.VarChar(255)
  mime         String   @db.VarChar(127)
  size         Int
  diskPath     String   @map("disk_path") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([accountId])
  @@map("files")
}

model WebhookEndpoint {
  id             String    @id @default(uuid()) @db.VarChar(36)
  accountId      String    @map("account_id") @db.VarChar(36)
  createdBy      String?   @map("created_by") @db.VarChar(36)
  url            String    @db.VarChar(512)
  secret         String    @db.Text
  events         String    @default("[]") @db.VarChar(2048)
  isActive       Boolean   @default(true) @map("is_active")
  lastDeliveryAt DateTime? @map("last_delivery_at") @db.DateTime(3)
  failureCount   Int       @default(0) @map("failure_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("webhook_endpoints")
}

// ============================================================
// CRM domain models — ported from the Supabase schema
// (supabase/migrations/*). snake_case columns via @@map.
// ============================================================

model Contact {
  id              String   @id @default(uuid()) @db.VarChar(36)
  accountId       String   @map("account_id") @db.VarChar(36)
  userId          String   @map("user_id") @db.VarChar(36)
  phone           String   @db.VarChar(32)
  phoneNormalized String?  @map("phone_normalized") @db.VarChar(32)
  name            String?  @db.VarChar(255)
  email           String?  @db.VarChar(255)
  company         String?  @db.VarChar(255)
  avatarUrl       String?  @map("avatar_url") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  account             Account                      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  conversations       Conversation[]
  contactTags         ContactTag[]                 @relation("ContactTagContact")
  recipients          BroadcastRecipient[]
  deals               Deal[]
  automationLogs      AutomationLog[]
  automationPending   AutomationPendingExecution[]
  notifications       Notification[]
  messageReactions    MessageReaction[]
  contactCustomValues ContactCustomValue[]
  contactNotes        ContactNote[]
  flowRuns            FlowRun[]

  @@unique([accountId, phoneNormalized])
  @@index([accountId])
  @@index([phone])
  @@map("contacts")
}

model Tag {
  id        String   @id @default(uuid()) @db.VarChar(36)
  accountId String   @map("account_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  color     String   @default("#3b82f6") @db.VarChar(16)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactTags ContactTag[] @relation("ContactTagTag")

  @@index([accountId])
  @@map("tags")
}

model ContactTag {
  id        String   @id @default(uuid()) @db.VarChar(36)
  contactId String   @map("contact_id") @db.VarChar(36)
  tagId     String   @map("tag_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  contact Contact @relation("ContactTagContact", fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation("ContactTagTag", fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
  @@map("contact_tags")
}

model Conversation {
  id                  String             @id @default(uuid()) @db.VarChar(36)
  accountId           String             @map("account_id") @db.VarChar(36)
  userId              String             @map("user_id") @db.VarChar(36)
  contactId           String             @map("contact_id") @db.VarChar(36)
  status              ConversationStatus @default(open)
  assignedAgentId     String?            @map("assigned_agent_id") @db.VarChar(36)
  lastMessageText     String?            @map("last_message_text") @db.Text
  lastMessageAt       DateTime?          @map("last_message_at") @db.DateTime(3)
  unreadCount         Int                @default(0) @map("unread_count")
  aiAutoreplyDisabled Boolean            @default(false) @map("ai_autoreply_disabled")
  aiReplyCount        Int                @default(0) @map("ai_reply_count")
  createdAt           DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  account          Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact          Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  messages         Message[]
  deals            Deal[]
  notifications    Notification[]
  messageReactions MessageReaction[]
  flowRuns         FlowRun[]

  @@unique([accountId, contactId])
  @@index([contactId])
  @@map("conversations")
}

model Message {
  id                 String        @id @default(uuid()) @db.VarChar(36)
  conversationId     String        @map("conversation_id") @db.VarChar(36)
  senderType         SenderType    @map("sender_type")
  senderId           String?       @map("sender_id") @db.VarChar(36)
  contentType        ContentType   @default(text) @map("content_type")
  contentText        String?       @map("content_text") @db.Text
  mediaUrl           String?       @map("media_url") @db.Text
  templateName       String?       @map("template_name") @db.VarChar(255)
  messageId          String?       @map("message_id") @db.VarChar(255)
  status             MessageStatus @default(sent)
  replyToMessageId   String?       @map("reply_to_message_id") @db.VarChar(36)
  interactiveReplyId String?       @map("interactive_reply_id") @db.VarChar(255)
  interactivePayload Json?         @map("interactive_payload")
  aiGenerated        Boolean       @default(false) @map("ai_generated")
  createdAt          DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  flowRuns     FlowRun[]

  @@unique([conversationId, messageId])
  @@index([messageId])
  @@index([replyToMessageId])
  @@map("messages")
}

model WhatsAppConfig {
  id                    String               @id @default(uuid()) @db.VarChar(36)
  accountId             String               @unique @map("account_id") @db.VarChar(36)
  userId                String               @map("user_id") @db.VarChar(36)
  phoneNumberId         String               @unique @map("phone_number_id") @db.VarChar(64)
  wabaId                String?              @map("waba_id") @db.VarChar(64)
  accessToken           String               @map("access_token") @db.Text
  verifyToken           String?              @map("verify_token") @db.Text
  status                WhatsAppConfigStatus @default(disconnected)
  connectedAt           DateTime?            @map("connected_at") @db.DateTime(3)
  registeredAt          DateTime?            @map("registered_at") @db.DateTime(3)
  subscribedAppsAt      DateTime?            @map("subscribed_apps_at") @db.DateTime(3)
  lastRegistrationError String?              @map("last_registration_error") @db.Text
  createdAt             DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.DateTime(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("whatsapp_config")
}

model MessageTemplate {
  id              String                  @id @default(uuid()) @db.VarChar(36)
  accountId       String                  @map("account_id") @db.VarChar(36)
  userId          String                  @map("user_id") @db.VarChar(36)
  name            String                  @db.VarChar(255)
  category        MessageTemplateCategory @default(Marketing)
  language        String                  @default("en_US") @db.VarChar(16)
  headerType      TemplateHeaderType?     @map("header_type")
  headerContent   String?                 @map("header_content") @db.Text
  bodyText        String                  @map("body_text") @db.Text
  footerText      String?                 @map("footer_text") @db.Text
  buttons         Json?                   @map("buttons")
  sampleValues    Json?                   @map("sample_values")
  metaTemplateId  String?                 @map("meta_template_id") @db.VarChar(255)
  rejectionReason String?                 @map("rejection_reason") @db.Text
  qualityScore    TemplateQualityScore?   @map("quality_score")
  headerHandle    String?                 @map("header_handle") @db.VarChar(512)
  headerMediaUrl  String?                 @map("header_media_url") @db.Text
  submissionError String?                 @map("submission_error") @db.Text
  lastSubmittedAt DateTime?               @map("last_submitted_at") @db.DateTime(3)
  status          MessageTemplateStatus   @default(DRAFT)
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, name, language])
  @@index([accountId])
  @@index([metaTemplateId])
  @@map("message_templates")
}

model Broadcast {
  id                String          @id @default(uuid()) @db.VarChar(36)
  accountId         String          @map("account_id") @db.VarChar(36)
  userId            String          @map("user_id") @db.VarChar(36)
  name              String          @db.VarChar(255)
  templateName      String          @map("template_name") @db.VarChar(255)
  templateLanguage  String          @default("en_US") @map("template_language") @db.VarChar(16)
  templateVariables Json?           @map("template_variables")
  audienceFilter    Json?           @map("audience_filter")
  scheduledAt       DateTime?       @map("scheduled_at") @db.DateTime(3)
  status            BroadcastStatus @default(draft)
  totalRecipients   Int             @default(0) @map("total_recipients")
  sentCount         Int             @default(0) @map("sent_count")
  deliveredCount    Int             @default(0) @map("delivered_count")
  readCount         Int             @default(0) @map("read_count")
  repliedCount      Int             @default(0) @map("replied_count")
  failedCount       Int             @default(0) @map("failed_count")
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  account    Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  recipients BroadcastRecipient[]

  @@index([accountId])
  @@map("broadcasts")
}

model BroadcastRecipient {
  id                String                   @id @default(uuid()) @db.VarChar(36)
  broadcastId       String                   @map("broadcast_id") @db.VarChar(36)
  contactId         String?                  @map("contact_id") @db.VarChar(36)
  status            BroadcastRecipientStatus @default(pending)
  sentAt            DateTime?                @map("sent_at") @db.DateTime(3)
  deliveredAt       DateTime?                @map("delivered_at") @db.DateTime(3)
  readAt            DateTime?                @map("read_at") @db.DateTime(3)
  repliedAt         DateTime?                @map("replied_at") @db.DateTime(3)
  errorMessage      String?                  @map("error_message") @db.Text
  whatsappMessageId String?                  @unique @map("whatsapp_message_id") @db.VarChar(255)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.DateTime(3)

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([broadcastId, status])
  @@index([contactId])
  @@map("broadcast_recipients")
}

// ============================================================
// New domain models — profiles, deals, pipelines, automations,
// notifications, presence, reactions, custom fields, AI, flows
// ============================================================

model Profile {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @unique @map("user_id") @db.VarChar(36)
  fullName  String?  @map("full_name") @db.VarChar(255)
  email     String?  @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.Text
  role      String   @default("user") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedDeals Deal[]

  @@map("profiles")
}

model Pipeline {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  name      String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  deals          Deal[]
  pipelineStages PipelineStage[]

  @@index([userId])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid()) @db.VarChar(36)
  pipelineId String   @map("pipeline_id") @db.VarChar(36)
  name       String   @db.VarChar(255)
  position   Int
  color      String   @default("#3b82f6") @db.VarChar(16)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@index([pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id                String    @id @default(uuid()) @db.VarChar(36)
  userId            String    @map("user_id") @db.VarChar(36)
  pipelineId        String    @map("pipeline_id") @db.VarChar(36)
  stageId           String    @map("stage_id") @db.VarChar(36)
  contactId         String    @map("contact_id") @db.VarChar(36)
  conversationId    String?   @map("conversation_id") @db.VarChar(36)
  title             String    @db.VarChar(255)
  value             Decimal   @db.Decimal(12, 2)
  currency          String    @default("USD") @db.VarChar(3)
  notes             String?   @db.Text
  expectedCloseDate DateTime? @map("expected_close_date") @db.DateTime(3)
  status            String    @default("open") @db.VarChar(50)
  assignedTo        String?   @map("assigned_to") @db.VarChar(36)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  pipeline     Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  contact      Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  assignee     Profile?      @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([pipelineId])
  @@index([stageId])
  @@index([contactId])
  @@index([conversationId])
  @@index([assignedTo])
  @@map("deals")
}

model Automation {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  triggerType    String    @map("trigger_type") @db.VarChar(50)
  triggerConfig  Json      @map("trigger_config")
  isActive       Boolean   @default(false) @map("is_active")
  executionCount Int       @default(0) @map("execution_count")
  lastExecutedAt DateTime? @map("last_executed_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  steps             AutomationStep[]
  logs              AutomationLog[]
  pendingExecutions AutomationPendingExecution[]

  @@index([userId])
  @@map("automations")
}

model AutomationStep {
  id           String   @id @default(uuid()) @db.VarChar(36)
  automationId String   @map("automation_id") @db.VarChar(36)
  parentStepId String?  @map("parent_step_id") @db.VarChar(36)
  branch       String?  @db.VarChar(10)
  stepType     String   @map("step_type") @db.VarChar(50)
  stepConfig   Json     @map("step_config")
  position     Int
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  automation      Automation                   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  parentStep      AutomationStep?              @relation("AutomationStepBranch", fields: [parentStepId], references: [id], onDelete: SetNull)
  childSteps      AutomationStep[]             @relation("AutomationStepBranch")
  pendingAsParent AutomationPendingExecution[] @relation("AutomationStepPendingParent")

  @@index([automationId])
  @@index([parentStepId])
  @@map("automation_steps")
}

model AutomationLog {
  id            String   @id @default(uuid()) @db.VarChar(36)
  automationId  String   @map("automation_id") @db.VarChar(36)
  userId        String   @map("user_id") @db.VarChar(36)
  contactId     String?  @map("contact_id") @db.VarChar(36)
  triggerEvent  Json?    @map("trigger_event")
  stepsExecuted Json?    @map("steps_executed")
  status        String   @db.VarChar(20)
  errorMessage  String?  @map("error_message") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  automation Automation                   @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    Contact?                     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  pending    AutomationPendingExecution[]

  @@index([automationId])
  @@index([userId])
  @@index([contactId])
  @@map("automation_logs")
}

model AutomationPendingExecution {
  id               String   @id @default(uuid()) @db.VarChar(36)
  automationId     String   @map("automation_id") @db.VarChar(36)
  userId           String   @map("user_id") @db.VarChar(36)
  contactId        String?  @map("contact_id") @db.VarChar(36)
  logId            String?  @map("log_id") @db.VarChar(36)
  parentStepId     String?  @map("parent_step_id") @db.VarChar(36)
  branch           String?  @db.VarChar(10)
  nextStepPosition Int      @map("next_step_position")
  context          Json
  status           String   @default("pending") @db.VarChar(20)
  runAt            DateTime @map("run_at") @db.DateTime(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  automation Automation      @relation(fields: [automationId], references: [id], onDelete: Cascade)
  contact    Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  log        AutomationLog?  @relation(fields: [logId], references: [id], onDelete: SetNull)
  parentStep AutomationStep? @relation("AutomationStepPendingParent", fields: [parentStepId], references: [id], onDelete: SetNull)

  @@index([automationId])
  @@index([userId])
  @@index([contactId])
  @@index([logId])
  @@index([parentStepId])
  @@index([status, runAt])
  @@map("automation_pending_executions")
}

model Notification {
  id             String    @id @default(uuid()) @db.VarChar(36)
  accountId      String    @map("account_id") @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  type           String    @default("conversation_assigned") @db.VarChar(50)
  conversationId String?   @map("conversation_id") @db.VarChar(36)
  contactId      String?   @map("contact_id") @db.VarChar(36)
  actorUserId    String?   @map("actor_user_id") @db.VarChar(36)
  title          String    @db.VarChar(255)
  body           String?   @db.Text
  readAt         DateTime? @map("read_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([userId])
  @@index([conversationId])
  @@index([contactId])
  @@map("notifications")
}

model MemberPresence {
  userId     String   @id @map("user_id") @db.VarChar(36)
  accountId  String   @map("account_id") @db.VarChar(36)
  status     String   @db.VarChar(20)
  lastSeenAt DateTime @map("last_seen_at") @db.DateTime(3)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("member_presence")
}

model MessageReaction {
  id             String   @id @default(uuid()) @db.VarChar(36)
  messageId      String   @map("message_id") @db.VarChar(36)
  conversationId String   @map("conversation_id") @db.VarChar(36)
  actorType      String   @map("actor_type") @db.VarChar(20)
  actorId        String?  @db.VarChar(36)
  emoji          String   @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact?     @relation(fields: [contactId], references: [id])
  contactId    String?      @db.VarChar(36)

  @@unique([messageId, actorType, actorId])
  @@index([messageId])
  @@index([conversationId])
  @@map("message_reactions")
}

model CustomField {
  id           String   @id @default(uuid()) @db.VarChar(36)
  userId       String   @map("user_id") @db.VarChar(36)
  fieldName    String   @map("field_name") @db.VarChar(255)
  fieldType    String   @default("text") @map("field_type") @db.VarChar(50)
  fieldOptions Json?    @map("field_options")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  customValues ContactCustomValue[]

  @@index([userId])
  @@map("custom_fields")
}

model ContactCustomValue {
  id            String   @id @default(uuid()) @db.VarChar(36)
  contactId     String   @map("contact_id") @db.VarChar(36)
  customFieldId String   @map("custom_field_id") @db.VarChar(36)
  value         String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  contact     Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)

  @@unique([contactId, customFieldId])
  @@index([contactId])
  @@index([customFieldId])
  @@map("contact_custom_values")
}

model ContactNote {
  id        String   @id @default(uuid()) @db.VarChar(36)
  contactId String   @map("contact_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  noteText  String   @map("note_text") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@map("contact_notes")
}

model QuickReply {
  id          String   @id @default(uuid()) @db.VarChar(36)
  userId      String   @map("user_id") @db.VarChar(36)
  shortcut    String   @db.VarChar(100)
  messageText String   @map("message_text") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@index([userId])
  @@map("quick_replies")
}

// ============================================================
// AI models
// ============================================================

model AiConfig {
  id                          String   @id @default(uuid()) @db.VarChar(36)
  accountId                   String   @unique @map("account_id") @db.VarChar(36)
  createdBy                   String?  @map("created_by") @db.VarChar(36)
  provider                    String   @db.VarChar(50)
  model                       String   @db.VarChar(100)
  apiKey                      String   @map("api_key") @db.Text
  systemPrompt                String?  @map("system_prompt") @db.Text
  isActive                    Boolean  @default(false) @map("is_active")
  autoReplyEnabled            Boolean  @default(false) @map("auto_reply_enabled")
  autoReplyMaxPerConversation Int      @default(3) @map("auto_reply_max_per_conversation")
  embeddingsApiKey            String?  @map("embeddings_api_key") @db.Text
  createdAt                   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  account   Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  documents AiKnowledgeDocument[]
  chunks    AiKnowledgeChunk[]
  usageLogs AiUsageLog[]

  @@index([accountId])
  @@map("ai_configs")
}

model AiKnowledgeDocument {
  id        String   @id @default(uuid()) @db.VarChar(36)
  accountId String   @map("account_id") @db.VarChar(36)
  createdBy String?  @map("created_by") @db.VarChar(36)
  title     String   @db.VarChar(255)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  account    Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  chunks     AiKnowledgeChunk[]
  aiConfig   AiConfig?          @relation(fields: [aiConfigId], references: [id])
  aiConfigId String?            @db.VarChar(36)

  @@index([accountId])
  @@map("ai_knowledge_documents")
}

model AiKnowledgeChunk {
  id         String   @id @default(uuid()) @db.VarChar(36)
  documentId String   @map("document_id") @db.VarChar(36)
  accountId  String   @map("account_id") @db.VarChar(36)
  chunkIndex Int      @map("chunk_index")
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  document   AiKnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  account    Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  aiConfig   AiConfig?           @relation(fields: [aiConfigId], references: [id])
  aiConfigId String?             @db.VarChar(36)

  @@index([documentId])
  @@index([accountId])
  @@map("ai_knowledge_chunks")
}

model AiUsageLog {
  id        String   @id @default(uuid()) @db.VarChar(36)
  accountId String   @map("account_id") @db.VarChar(36)
  userId    String   @map("user_id") @db.VarChar(36)
  provider  String   @db.VarChar(50)
  model     String   @db.VarChar(100)
  tokensIn  Int      @map("tokens_in")
  tokensOut Int      @map("tokens_out")
  costUsd   Decimal? @map("cost_usd") @db.Decimal(12, 6)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  aiConfig   AiConfig? @relation(fields: [aiConfigId], references: [id])
  aiConfigId String?   @db.VarChar(36)

  @@index([accountId])
  @@index([userId])
  @@map("ai_usage_logs")
}

// ============================================================
// Flow models — visual flow builder
// ============================================================

model Flow {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  name           String    @db.VarChar(255)
  description    String?   @db.Text
  status         String    @default("draft") @db.VarChar(20)
  triggerType    String    @map("trigger_type") @db.VarChar(50)
  triggerConfig  Json      @map("trigger_config")
  entryNodeId    String?   @map("entry_node_id") @db.VarChar(255)
  fallbackPolicy Json      @default("{}") @map("fallback_policy")
  executionCount Int       @default(0) @map("execution_count")
  lastExecutedAt DateTime? @map("last_executed_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  nodes FlowNode[]
  runs  FlowRun[]

  @@index([userId])
  @@map("flows")
}

model FlowNode {
  id        String   @id @default(uuid()) @db.VarChar(36)
  flowId    String   @map("flow_id") @db.VarChar(36)
  nodeKey   String   @map("node_key") @db.VarChar(255)
  nodeType  String   @map("node_type") @db.VarChar(50)
  config    Json
  positionX Int      @default(0) @map("position_x")
  positionY Int      @default(0) @map("position_y")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  flow Flow @relation(fields: [flowId], references: [id], onDelete: Cascade)

  @@unique([flowId, nodeKey])
  @@index([flowId])
  @@map("flow_nodes")
}

model FlowRun {
  id                  String    @id @default(uuid()) @db.VarChar(36)
  flowId              String    @map("flow_id") @db.VarChar(36)
  userId              String    @map("user_id") @db.VarChar(36)
  contactId           String?   @map("contact_id") @db.VarChar(36)
  conversationId      String?   @map("conversation_id") @db.VarChar(36)
  status              String    @default("active") @db.VarChar(20)
  currentNodeKey      String    @map("current_node_key") @db.VarChar(255)
  lastPromptMessageId String?   @map("last_prompt_message_id") @db.VarChar(36)
  vars                Json      @default("{}")
  repromptCount       Int       @default(0) @map("reprompt_count")
  startedAt           DateTime  @map("started_at") @db.DateTime(3)
  lastAdvancedAt      DateTime  @map("last_advanced_at") @db.DateTime(3)
  endedAt             DateTime? @map("ended_at") @db.DateTime(3)
  endReason           String?   @map("end_reason") @db.Text

  flow              Flow           @relation(fields: [flowId], references: [id], onDelete: Cascade)
  contact           Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation      Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  lastPromptMessage Message?       @relation(fields: [lastPromptMessageId], references: [id], onDelete: SetNull)
  events            FlowRunEvent[]

  @@index([flowId])
  @@index([userId])
  @@index([contactId])
  @@index([conversationId])
  @@index([lastPromptMessageId])
  @@map("flow_runs")
}

model FlowRunEvent {
  id        String   @id @default(uuid()) @db.VarChar(36)
  flowRunId String   @map("flow_run_id") @db.VarChar(36)
  eventType String   @map("event_type") @db.VarChar(50)
  nodeKey   String   @map("node_key") @db.VarChar(255)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  flowRun FlowRun @relation(fields: [flowRunId], references: [id], onDelete: Cascade)

  @@index([flowRunId])
  @@map("flow_run_events")
}

